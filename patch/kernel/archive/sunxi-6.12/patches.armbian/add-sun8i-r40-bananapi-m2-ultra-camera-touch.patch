From: Armbian <armbian@armbian.com>
Subject: [PATCH] arm: dts: sun8i-r40-bananapi-m2-ultra: Add OV5640 camera and touch support

This patch was automatically generated by create_correct_patches.sh
using proper git diff against the kernel worktree.

Signed-off-by: Armbian <armbian@armbian.com>
---
 arch/arm/boot/dts/allwinner/sun8i-r40-bananapi-m2-ultra.dts | 99 ++++++++++++++++++++++
 1 file changed, 99 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun8i-r40-bananapi-m2-ultra.dts b/arch/arm/boot/dts/allwinner/sun8i-r40-bananapi-m2-ultra.dts
index cd2351acc32f..9af58a43ec0b 100644
--- a/arch/arm/boot/dts/allwinner/sun8i-r40-bananapi-m2-ultra.dts
+++ b/arch/arm/boot/dts/allwinner/sun8i-r40-bananapi-m2-ultra.dts
@@ -338,3 +338,67 @@ &usbphy {
 	usb2_vbus-supply = <&reg_vcc5v0>;
 	status = "okay";
 };
+
+/* OV5640 Camera Support */
+&i2c4 {
+	status = "okay";
+
+	ov5640: camera@3c {
+		compatible = "ovti,ov5640";
+		reg = <0x3c>;
+		clocks = <&ccu CLK_OUTA>;
+		clock-names = "xclk";
+		AVDD-supply = <&reg_dldo1>;    /* 2.8V */
+		DOVDD-supply = <&reg_dldo1>;   /* 2.8V */
+		DVDD-supply = <&reg_eldo3>;    /* 1.5V */
+		reset-gpios = <&pio 8 7 GPIO_ACTIVE_LOW>;   /* PI7 */
+		powerdown-gpios = <&pio 8 6 GPIO_ACTIVE_HIGH>; /* PI6 */
+		rotation = <180>;
+		status = "okay";
+
+		port {
+			ov5640_ep: endpoint {
+				remote-endpoint = <&csi0_ep>;
+				bus-type = <5>;    /* Parallel */
+				bus-width = <8>;
+				hsync-active = <1>;
+				vsync-active = <0>;
+				data-active = <1>;
+				pclk-sample = <1>;
+			};
+		};
+	};
+};
+
+/* Goodix GT911 Touch Panel Support */
+&i2c1 {
+	status = "okay";
+
+	touchscreen@5d {
+		compatible = "goodix,gt911";
+		reg = <0x5d>;
+		interrupt-parent = <&pio>;
+		interrupts = <8 10 IRQ_TYPE_EDGE_FALLING>;  /* PI10 */
+		reset-gpios = <&pio 8 11 GPIO_ACTIVE_HIGH>; /* PI11 */
+		irq-gpios = <&pio 8 10 GPIO_ACTIVE_HIGH>;   /* PI10 */
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <480>;
+		status = "okay";
+	};
+};
+
+/* CSI0 Camera Interface */
+&csi0 {
+	status = "okay";
+
+	port {
+		csi0_ep: endpoint {
+			remote-endpoint = <&ov5640_ep>;
+			bus-width = <8>;
+			hsync-active = <1>;
+			vsync-active = <0>;
+			data-active = <1>;
+			pclk-sample = <1>;
+		};
+	};
+};
-- 
