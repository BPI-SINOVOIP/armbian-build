From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Banana Pi -BPI <lionwang@sinovoip.com.cn>
Date: Thu, 27 Aug 2026 11:30:00 +0800
Subject: [PATCH] arm64: dts: synaptics: Banana Pi M6 identity

保留 vendor 5.4 BSP 所依賴的舊 VS680 EVK compatible，並加入精確板級
compatible 與 model，供軟體辨識實際板卡。
---
 .../boot/dts/synaptics/vs680-a0-bananapi-m6-sdboot.dts | 4 ++--
 .../arm64/boot/dts/synaptics/vs680-a0-bananapi-m6.dts   | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6-sdboot.dts b/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6-sdboot.dts
index 69a7af5ad5fdc9cb1d30dc32b112a2f766d06743..15155af34a08bb3e2252a806968fff834dde7f1a 100755
--- a/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6-sdboot.dts
+++ b/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6-sdboot.dts
@@ -16,4 +16,4 @@
 / {
-	model = "Synaptics VS680 EVK";
-	compatible = "syna,vs680-evk", "syna,vs680";
+	model = "Banana Pi M6";
+	compatible = "sinovoip,bananapi-m6", "syna,vs680-evk", "syna,vs680";
 
diff --git a/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6.dts b/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6.dts
index 71adf7c51edfe04d624291351034cbf08e0aaf69..05282045f5a84abfac4009fc4e061607566f7150 100755
--- a/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6.dts
+++ b/arch/arm64/boot/dts/synaptics/vs680-a0-bananapi-m6.dts
@@ -16,4 +16,4 @@
 / {
-	model = "Synaptics VS680 EVK";
-	compatible = "syna,vs680-evk", "syna,vs680";
+	model = "Banana Pi M6";
+	compatible = "sinovoip,bananapi-m6", "syna,vs680-evk", "syna,vs680";
 
