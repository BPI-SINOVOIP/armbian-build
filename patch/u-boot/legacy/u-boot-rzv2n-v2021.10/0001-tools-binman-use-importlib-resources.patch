From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BPI-SINOVOIP <support@banana-pi.org>
Date: Thu, 27 Aug 2026 16:00:00 +0800
Subject: [PATCH] tools: binman: 改用 importlib.resources

新版 Python 環境不再保證提供 pkg_resources。改用標準
importlib.resources 介面，並保留舊環境的 backport 路徑。

Signed-off-by: BPI-SINOVOIP <support@banana-pi.org>
---
 tools/binman/control.py | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/tools/binman/control.py b/tools/binman/control.py
index dcba02ff7f8..85bf4ec37a2 100644
--- a/tools/binman/control.py
+++ b/tools/binman/control.py
@@ -10,3 +10,2 @@
 import os
-import pkg_resources
 import re
@@ -20,3 +19,9 @@
 from patman import tout
+try:
+    import importlib.resources as importlib_resources
+    importlib_resources.files
+except (ImportError, AttributeError):
+    import importlib_resources
+
-
+
 # List of images we plan to create
@@ -84,2 +89,2 @@ def _ReadMissingBlobHelp():
-    my_data = pkg_resources.resource_string(__name__, 'missing-blob-help')
+    my_data = importlib_resources.files(__package__).joinpath('missing-blob-help').read_bytes()
     re_tag = re.compile('^([-a-z0-9]+):$')
@@ -130,3 +135,3 @@ def GetEntryModules(include_testing=True):
     """
-    glob_list = pkg_resources.resource_listdir(__name__, 'etype')
+    glob_list = [r.name for r in importlib_resources.files(__package__).joinpath('etype').iterdir() if r.is_file()]
     glob_list = [fname for fname in glob_list if fname.endswith('.py')]
