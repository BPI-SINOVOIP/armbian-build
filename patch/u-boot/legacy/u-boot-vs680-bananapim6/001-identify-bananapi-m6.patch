index 8afc2e1e73e2bb29fbdf0790a620500cfa21fec2..30d3c76ef729c84a1f2aa72c325f90e8a0a85899 100755
--- a/arch/arm/dts/vs680-bananapi-m6.dts
+++ b/arch/arm/dts/vs680-bananapi-m6.dts
@@ -14,4 +14,4 @@
 / {
-	model = "Synaptics VS680 Bananapi-M6";
-	compatible = "Synaptics,vs680", "Synaptics,asserial";
+	model = "Banana Pi M6";
+	compatible = "sinovoip,bananapi-m6", "Synaptics,vs680", "Synaptics,asserial";
 
