diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -1,3 +1,11 @@
 if ARCH_SUNXI
 
+config BPI_SRAM_UPDATE
+	bool "啟用獨立 SRAM 更新器的受限寫入驅動"
+	depends on BPI_SRAM_SUPERVISOR
+	select SPL_MMC_WRITE
+	help
+	  僅供獨立更新器建置，保留媒體期限、PIO 與 24 MHz 上限。
+	  固定 SRAM 管理器不得啟用此選項。
+
 config BPI_SRAM_SUPERVISOR
diff --git a/arch/arm/mach-sunxi/board.c b/arch/arm/mach-sunxi/board.c
--- a/arch/arm/mach-sunxi/board.c
+++ b/arch/arm/mach-sunxi/board.c
@@ -461,3 +461,4 @@
 #ifdef CONFIG_BPI_SRAM_SUPERVISOR
 	extern char __bss_start[], __bss_end[];
+	extern void bpi_update_run(ulong) __attribute__((noreturn));
 
@@ -474,3 +475,3 @@
 	preloader_console_init();
-	bpi_supervisor_run();
+	bpi_update_run(dummy);
 #else
diff --git a/drivers/mmc/sunxi_mmc.c b/drivers/mmc/sunxi_mmc.c
--- a/drivers/mmc/sunxi_mmc.c
+++ b/drivers/mmc/sunxi_mmc.c
@@ -16,3 +16,9 @@
 #include <common.h>
-#ifdef CONFIG_BPI_SRAM_SUPERVISOR
+#ifdef CONFIG_BPI_SRAM_UPDATE
+extern int bpi_update_mmc_poll_live(void);
+static inline int sup_sd_live(void)
+{
+	return bpi_update_mmc_poll_live();
+}
+#elif defined(CONFIG_BPI_SRAM_SUPERVISOR)
 extern int sup_sd_live(void);
@@ -273,4 +279,5 @@
 
 		if (IS_ENABLED(CONFIG_BPI_SRAM_SUPERVISOR) &&
-		    (!reading || !sup_sd_live() || get_timer(start) > timeout_msecs))
+		    ((!reading && !IS_ENABLED(CONFIG_BPI_SRAM_UPDATE)) ||
+		     !sup_sd_live() || get_timer(start) > timeout_msecs))
 			return -ETIMEDOUT;
@@ -348,4 +355,5 @@
 		return -ETIMEDOUT;
-	if (IS_ENABLED(CONFIG_BPI_SRAM_SUPERVISOR) && data &&
+	if (IS_ENABLED(CONFIG_BPI_SRAM_SUPERVISOR) &&
+	    !IS_ENABLED(CONFIG_BPI_SRAM_UPDATE) && data &&
 	    (data->flags & MMC_DATA_WRITE))
 		return -EPERM;
diff --git a/drivers/mmc/mmc.c b/drivers/mmc/mmc.c
--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -223,3 +223,17 @@
-static int mmc_send_cmd_retry(struct mmc *mmc, struct mmc_cmd *cmd,
+#ifdef CONFIG_BPI_SRAM_UPDATE
+extern int sup_sd_live(void);
+static ulong update_poll_start;
+static unsigned int update_poll_timeout;
+static bool update_poll_active;
+
+/* 同一截止時間涵蓋 CMD13、重試及控制器清理，不逐層重新計時。 */
+int bpi_update_mmc_poll_live(void)
+{
+	return sup_sd_live() && (!update_poll_active ||
+		get_timer(update_poll_start) < update_poll_timeout);
+}
+#endif
+
+static int mmc_send_cmd_retry(struct mmc *mmc, struct mmc_cmd *cmd,
 			      struct mmc_data *data, uint retries)
 {
@@ -229,4 +243,12 @@
 	do {
+#ifdef CONFIG_BPI_SRAM_UPDATE
+		if (!bpi_update_mmc_poll_live())
+			return -ETIMEDOUT;
+#endif
 		ret = mmc_send_cmd(mmc, cmd, data);
+#ifdef CONFIG_BPI_SRAM_UPDATE
+		if (!bpi_update_mmc_poll_live())
+			return -ETIMEDOUT;
+#endif
 	} while (ret && retries--);
 
@@ -275,3 +297,3 @@
-int mmc_poll_for_busy(struct mmc *mmc, int timeout_ms)
+static int mmc_poll_for_busy_impl(struct mmc *mmc, int timeout_ms)
 {
 	unsigned int status;
@@ -284,5 +306,13 @@
 	while (1) {
+#ifdef CONFIG_BPI_SRAM_UPDATE
+		if (!bpi_update_mmc_poll_live())
+			return -ETIMEDOUT;
+#endif
 		err = mmc_send_status(mmc, &status);
 		if (err)
 			return err;
+#ifdef CONFIG_BPI_SRAM_UPDATE
+		if (!bpi_update_mmc_poll_live())
+			return -ETIMEDOUT;
+#endif
 
@@ -301,4 +331,6 @@
 
+#ifndef CONFIG_BPI_SRAM_UPDATE
 		if (timeout_ms-- <= 0)
 			break;
+#endif
 
@@ -318,5 +350,27 @@
 	return 0;
 }
 
+int mmc_poll_for_busy(struct mmc *mmc, int timeout_ms)
+{
+#ifdef CONFIG_BPI_SRAM_UPDATE
+	int ret;
+
+	if (timeout_ms <= 0)
+		return -EINVAL;
+	if (update_poll_active)
+		return -EBUSY;
+	update_poll_start = get_timer(0);
+	update_poll_timeout = timeout_ms;
+	update_poll_active = true;
+	ret = mmc_poll_for_busy_impl(mmc, timeout_ms);
+	if (!bpi_update_mmc_poll_live())
+		ret = -ETIMEDOUT;
+	update_poll_active = false;
+	return ret;
+#else
+	return mmc_poll_for_busy_impl(mmc, timeout_ms);
+#endif
+}
+
 int mmc_set_blocklen(struct mmc *mmc, int len)
 {
