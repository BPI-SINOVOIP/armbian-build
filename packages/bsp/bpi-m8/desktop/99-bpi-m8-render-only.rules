# The GPU is a render device, not an additional display seat.
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", DRIVERS=="pvrsrvkm", TAG-="seat", TAG-="master-of-seat", TAG-="uaccess", GROUP="video", MODE="0600"
SUBSYSTEM=="drm", KERNEL=="renderD*", DRIVERS=="pvrsrvkm", TAG-="seat", GROUP="render", MODE="0660", TAG+="uaccess"
