# DO NOT EDIT THIS FILE
#
# Please edit /boot/armbianEnv.txt to set supported parameters
#

# default values
setenv load_addr "0x47000000"
if test -z "${kernel_addr_r}"; then setenv kernel_addr_r "0x40080000"; fi
if test -z "${ramdisk_addr_r}"; then setenv ramdisk_addr_r "0x43000000"; fi
if test -z "${fdt_addr_r}"; then setenv fdt_addr_r "0x46000000"; fi
if test -z "${fdt_high}"; then setenv fdt_high "0xffffffffffffffff"; fi
if test -z "${initrd_high}"; then setenv initrd_high "0xffffffffffffffff"; fi
setenv overlay_error "false"
setenv verbosity "8"
setenv console "both"
setenv bootlogo "false"
setenv rootfstype "ext4"
setenv docker_optimizations "off"
setenv earlycon "off"
setenv emmc_single_part "false"
if test -z "${devtype}"; then setenv devtype "mmc"; fi
if test -z "${devnum}"; then setenv devnum "0"; fi
if test -z "${bootpart}"; then setenv bootpart "1"; fi
if test -z "${rootpart}"; then setenv rootpart "2"; fi
if test -z "${prefix}"; then setenv prefix "/"; fi
if test -z "${fdtfile}"; then setenv fdtfile "sunxi/sun60i-a733-bananapi-m8.dtb"; fi
if test -z "${overlay_prefix}"; then setenv overlay_prefix "sun60i-a733"; fi

echo "Boot script loaded from ${devtype} ${devnum}"

if load ${devtype} ${devnum}:${bootpart} ${load_addr} ${prefix}armbianEnv.txt; then
	env import -t ${load_addr} ${filesize}
elif load ${devtype} ${devnum}:1 ${load_addr} /boot/armbianEnv.txt; then
	setenv bootpart "1"
	setenv rootpart "1"
	setenv prefix "/boot/"
	setenv emmc_single_part "true"
	env import -t ${load_addr} ${filesize}
fi
if test "${prefix}" = "/boot/"; then setenv emmc_single_part "true"; fi

if test "${logo}" = "disabled"; then setenv logo "logo.nologo"; fi

if test "${console}" = "display"; then setenv consoleargs "console=tty1"; fi
if test "${console}" = "serial"; then setenv consoleargs "console=ttyS0,115200"; fi
if test "${console}" = "both"; then setenv consoleargs "console=tty1 console=ttyS0,115200"; fi
if test "${earlycon}" = "on"; then setenv consoleargs "earlyprintk=sunxi-uart,0x02500000 initcall_debug=0 ${consoleargs}"; fi
if test "${bootlogo}" = "true"; then
	setenv consoleargs "splash plymouth.ignore-serial-consoles ${consoleargs}";
else
	setenv consoleargs "splash=verbose ${consoleargs}";
fi

# SD images use FAT partition #1 and root partition #2. The eMMC installer
# creates a single ext4 partition with boot files in /boot. Always derive the
# root partition from the boot device so one script works after cloning SD to
# eMMC and does not keep a stale UUID from armbianEnv.txt.
setenv rootdev
setenv partuuid
if test -z "${rootdev}"; then
	part uuid ${devtype} ${devnum}:${rootpart} partuuid

	if test -n "${partuuid}"; then
		setenv rootdev "PARTUUID=${partuuid}"
	else
		# Fallback for vendor U-Boot variants where "part uuid" may fail.
		setenv rootdev "/dev/mmcblk${devnum}p${rootpart}"
	fi
fi
echo "Final rootdev: ${rootdev}"

if test -z "${displayargs}"; then setenv displayargs "video=HDMI-A-1:e drm_kms_helper.poll=0"; fi

setenv bootargs "root=${rootdev} rootwait rootfstype=${rootfstype} ${consoleargs} consoleblank=0 loglevel=${verbosity} usb-storage.quirks=${usbstoragequirks} ${displayargs} ${extraargs} ${extraboardargs}"

if test "${docker_optimizations}" = "on"; then setenv bootargs "${bootargs} cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1"; fi

setenv rdsize
setenv filesize
if load ${devtype} ${devnum}:${bootpart} ${ramdisk_addr_r} ${prefix}uInitrd; then
	setenv rdsize ${filesize}
else
	echo "ERROR: Cannot load ${prefix}uInitrd from ${devtype} ${devnum}:${bootpart}; aborting boot script."
	exit 1
fi

if load ${devtype} ${devnum}:${bootpart} ${kernel_addr_r} ${prefix}Image; then
	echo "Kernel loaded."
else
	echo "ERROR: Cannot load ${prefix}Image from ${devtype} ${devnum}:${bootpart}; aborting boot script."
	exit 1
fi

if load ${devtype} ${devnum}:${bootpart} ${fdt_addr_r} ${prefix}dtb/${fdtfile}; then
	echo "Device tree loaded."
else
	echo "ERROR: Cannot load ${prefix}dtb/${fdtfile} from ${devtype} ${devnum}:${bootpart}; aborting boot script."
	exit 1
fi
if fdt addr ${fdt_addr_r} && fdt resize 0x40000; then
	echo "Device tree ready."
else
	echo "ERROR: Invalid device tree or insufficient space; aborting boot script."
	exit 1
fi
fdt set /chosen bootargs "${bootargs}"
fdt set /chosen stdout-path "serial0:115200n8"
# Apply kernel and user overlays, including the board-specific subdirectory.
for overlay_file in ${overlays}; do
	if load ${devtype} ${devnum}:${bootpart} ${load_addr} ${prefix}dtb/sunxi/overlay/${overlay_prefix}-${overlay_file}.dtbo; then
		echo "Applying kernel DT overlay ${overlay_prefix}-${overlay_file}.dtbo"
		fdt apply ${load_addr} || setenv overlay_error "true"
	elif load ${devtype} ${devnum}:${bootpart} ${load_addr} ${prefix}dtb/sunxi/overlay/bpi-m8/${overlay_prefix}-${overlay_file}.dtbo; then
		echo "Applying kernel DT overlay bpi-m8/${overlay_prefix}-${overlay_file}.dtbo"
		fdt apply ${load_addr} || setenv overlay_error "true"
	fi
done
for overlay_file in ${user_overlays}; do
	if load ${devtype} ${devnum}:${bootpart} ${load_addr} ${prefix}overlay-user/${overlay_file}.dtbo; then
		echo "Applying user DT overlay ${overlay_file}.dtbo"
		fdt apply ${load_addr} || setenv overlay_error "true"
	fi
done
if test "${overlay_error}" = "true"; then
	echo "Overlay apply failed, restoring base DTB"
	if load ${devtype} ${devnum}:${bootpart} ${fdt_addr_r} ${prefix}dtb/${fdtfile}; then
		echo "Base device tree reloaded."
	else
		echo "ERROR: Cannot restore base device tree; aborting boot script."
		exit 1
	fi
	if fdt addr ${fdt_addr_r} && fdt resize 0x40000; then
		echo "Base device tree ready."
	else
		echo "ERROR: Invalid restored device tree or insufficient space; aborting boot script."
		exit 1
	fi
	fdt set /chosen bootargs "${bootargs}"
	fdt set /chosen stdout-path "serial0:115200n8"
fi
# Avoid vendor checksum path for Android-style initrd variables when booting raw Image/uInitrd.
setenv ramdisk_size
setenv ramdisk_start
setenv ramdisk_sum

booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}

# Recompile with:
# mkimage -C none -A arm -T script -d /boot/boot.cmd /boot/boot.scr
