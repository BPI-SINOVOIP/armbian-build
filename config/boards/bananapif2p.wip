# Sunplus SP7021 工業控制閘道板；候選僅限內部 SD 研究用途。
BOARD_NAME="Banana Pi F2P"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="sunplus-sp7021-bpi"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2021"

KERNEL_TARGET="legacy"
KERNEL_TEST_TARGET="legacy"
BOOTCONFIG="sp7021_bpi_f2p_defconfig"
BOOT_FDT_FILE="sp7021-bpi-f2p.dtb"
SRC_EXTLINUX="no"
BOOTFS_TYPE="fat"
BOOTSIZE="256"
SERIALCON="ttyS0"
HAS_VIDEO_OUTPUT="yes"
PACKAGE_LIST_BOARD="gpiod i2c-tools python3-libgpiod python3-spidev usbutils v4l-utils ethtool mtd-utils mmc-utils tpm2-tools"

SUNPLUS_BPI_BSP_REPO="https://github.com/BPI-SINOVOIP/BPI-F2S-bsp.git"
SUNPLUS_BPI_BSP_BRANCH="commit:3eee97bd8fb7582c2d9942a533647c3d78222bb5"
ARMBIAN_FIRMWARE_GIT_SOURCE_BOARD="https://github.com/armbian/firmware"
ARMBIAN_FIRMWARE_GIT_REF_BOARD="commit:f50a2a21bcdb77a562b3976930c5c6b521a1df08"
SUNPLUS_BPI_BSP_BOARD="bpi-f2p"
SUNPLUS_BPI_VENDOR_BOARD="bpi-f2p"
SUNPLUS_BPI_VENDOR_CHIP="SP7021"
SUNPLUS_BPI_SD_XBOOT_ASSET="sp-pack/sp7021/common/bin/ISPBOOOT.BIN"
SUNPLUS_BPI_SD_XBOOT_SHA256="e01081a92b55156868b9df7918e0d5f503d1dda3af94335ed24637786124964a"
SUNPLUS_BPI_EMMC_XBOOT_ASSET=""
SUNPLUS_BPI_EMMC_XBOOT_SHA256=""
SUNPLUS_BPI_CANDIDATE_MEDIA="sd-only"
SUNPLUS_BPI_PUBLIC_RELEASE_ALLOWED="no"
SUNPLUS_BPI_HARDWARE_CLAIMS_ALLOWED="no"

function post_family_config__bananapif2p_storage_contract() {
	# F2P 沒有專用 eMMC xboot；候選只允許 MBR 格式的 microSD 映像。
	[[ -z "${SUNPLUS_BPI_EMMC_XBOOT_ASSET}" ]] || exit_with_error \
		"F2P SD-only 候選不得指定 eMMC xboot" "${SUNPLUS_BPI_EMMC_XBOOT_ASSET}"
	declare -g IMAGE_PARTITION_TABLE="msdos"
	declare -g ARMBIAN_FIRMWARE_GIT_SOURCE="${ARMBIAN_FIRMWARE_GIT_SOURCE_BOARD}"
	declare -g ARMBIAN_FIRMWARE_GIT_REF="${ARMBIAN_FIRMWARE_GIT_REF_BOARD}"
}

function custom_kernel_config__bananapif2p_diagnostics() {
	# 保留可由映像內容驗證的診斷介面；實際硬體可用性仍須實機驗證。
	opts_y+=(THERMAL THERMAL_OF SUNPLUS_SP7021_THERMAL)
	opts_y+=(WATCHDOG WATCHDOG_CORE SUNPLUS_WATCHDOG)
	opts_y+=(USB_CONFIGFS USB_CONFIGFS_MASS_STORAGE)
}
