# Rockchip RK3308B-S quad core 512MB SBC with eMMC, WiFi/BT and PoE
BOOT_SOC="rk3308"
BOARD_NAME="Banana Pi P2 Pro"
BOARD_VENDOR="sinovoip"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2023"
BOARDFAMILY="rockchip64"
BOOTCONFIG="bpi-p2-pro-rk3308_defconfig"
KERNEL_TARGET="current"
DEFAULT_CONSOLE="serial"
BOOT_FDT_FILE="rockchip/rk3308-bpi-p2-pro.dtb"
MODULES_BLACKLIST="rockchipdrm analogix_dp dw_mipi_dsi dw_hdmi gpu_sched lima hantro_vpu panfrost"
HAS_VIDEO_OUTPUT="no"
BOOTBRANCH_BOARD="tag:v2025.04"
BOOTPATCHDIR="v2025.04"
BOOT_SCENARIO="binman"
IMAGE_PARTITION_TABLE="gpt"
BL31_BLOB="rk33/rk3308_bl31_v2.26.elf"
DDR_BLOB="rk33/rk3308_ddr_589MHz_uart2_m1_v1.30.bin"
MINILOADER_BLOB="rk33/rk3308_miniloader_sd_nand_v1.13.bin"
OVERLAY_PREFIX="rk3308"
