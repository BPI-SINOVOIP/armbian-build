# Mediatek MT7986A quad-core Cortex-A53 router board
BOARD_NAME="Banana Pi R3"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="filogic"
BOARD_MAINTAINER=""
INTRODUCED="2022"
KERNEL_TARGET="current"
KERNEL_TEST_TARGET="current"
BOOTCONFIG="mt7986a_bpir3_sd_defconfig"
BOOT_FDT_FILE="mediatek/mt7986a-bananapi-bpi-r3-sd-nor.dtb"
SRC_EXTLINUX="yes"
SRC_CMDLINE="console=ttyS0,115200n1 earlyprintk loglevel=8 initcall_debug=0 swiotlb=512 cgroup_enable cgroup_memory=1 init=/sbin/init"
HAS_VIDEO_OUTPUT="no"

declare -g FILOGIC_SOC="mt7986"
declare -g FILOGIC_BOOT_DEVICE="sdmmc"
declare -g FILOGIC_ATF_FLAGS="DRAM_USE_DDR4=1 HAVE_DRAM_OBJ_FILE=yes"
