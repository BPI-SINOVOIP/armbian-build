# Rockchip RK3568B2 BPI-M4 Super L0 donor-only 參考；不是板級支援聲明。
BOARD_NAME="Banana Pi M4 Super（ArmSoM Sige3 donor-only）"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="rk35xx"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2024"
BOOTCONFIG="armsom-sige3-rk3568_defconfig"
KERNEL_TARGET="vendor"
KERNEL_TEST_TARGET="vendor"
FULL_DESKTOP="yes"
BOOT_LOGO="desktop"
BOOT_FDT_FILE="rockchip/rk3568-armsom-sige3.dtb"
BOOT_SCENARIO="spl-blobs"
IMAGE_PARTITION_TABLE="gpt"

# 只固定 donor 來源以便後續比對；不得據此宣稱 M4 Super 元件、映像或硬體已通過。
KERNELSOURCE_BOARD="https://github.com/armbian/linux-rockchip.git"
KERNELBRANCH_BOARD="commit:c6157104418d012823413c02f9222f3fe123dd25"
BOOTSOURCE_BOARD="https://github.com/radxa/u-boot.git"
BOOTBRANCH_BOARD="commit:39cd993e5d6296635438e84f4576b3a9bf76f86e"
RKBIN_GIT_URL_BOARD="https://github.com/armbian/rkbin"
RKBIN_GIT_URL="${RKBIN_GIT_URL_BOARD}"
RKBIN_GIT_REF="commit:1d3c61008fa823936ae7a59615393f8294b64456"
DDR_BLOB="rk35/rk3568_ddr_1560MHz_v1.21.bin"
BL31_BLOB="rk35/rk3568_bl31_v1.44.elf"
ROCKUSB_BLOB="rk35/rk356x_spl_loader_v1.21.113.bin"
ARMBIAN_FIRMWARE_GIT_SOURCE_BOARD="https://github.com/armbian/firmware"
ARMBIAN_FIRMWARE_GIT_REF_BOARD="commit:f50a2a21bcdb77a562b3976930c5c6b521a1df08"
M4SUPER_EVIDENCE_LEVEL="L0"
M4SUPER_DONOR_ONLY="yes"
M4SUPER_DONOR_BOARD="ArmSoM Sige3"

function post_family_config_branch_vendor__bananapim4super_pin_sources() {
	declare -g KERNELSOURCE="${KERNELSOURCE_BOARD}"
	declare -g KERNELBRANCH="${KERNELBRANCH_BOARD}"
	declare -g BOOTSOURCE="${BOOTSOURCE_BOARD}"
	declare -g BOOTBRANCH="${BOOTBRANCH_BOARD}"
	declare -g RKBIN_GIT_URL="${RKBIN_GIT_URL_BOARD}"
	declare -g RKBIN_GIT_REF="commit:1d3c61008fa823936ae7a59615393f8294b64456"
	declare -g ARMBIAN_FIRMWARE_GIT_SOURCE="${ARMBIAN_FIRMWARE_GIT_SOURCE_BOARD}"
	declare -g ARMBIAN_FIRMWARE_GIT_REF="${ARMBIAN_FIRMWARE_GIT_REF_BOARD}"
}
