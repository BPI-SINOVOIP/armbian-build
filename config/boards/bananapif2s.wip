# Sunplus SP7021 industrial board.
BOARD_NAME="Banana Pi F2S"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="sunplus-sp7021-bpi"
BOARD_MAINTAINER=""
INTRODUCED="2021"

KERNEL_TARGET="legacy"
KERNEL_TEST_TARGET="legacy"
BOOTCONFIG="sp7021_bpi_f2s_defconfig"
BOOT_FDT_FILE="sp7021-bpi-f2s.dtb"
SRC_EXTLINUX="no"
BOOTFS_TYPE="fat"
BOOTSIZE="256"
SERIALCON="ttyS0"
HAS_VIDEO_OUTPUT="yes"

SUNPLUS_BPI_BSP_REPO="https://github.com/BPI-SINOVOIP/BPI-F2S-bsp.git"
SUNPLUS_BPI_BSP_BRANCH="commit:3eee97bd8fb7582c2d9942a533647c3d78222bb5"
SUNPLUS_BPI_BSP_BOARD="bpi-f2s"
SUNPLUS_BPI_VENDOR_BOARD="bpi-f2s"
SUNPLUS_BPI_VENDOR_CHIP="SP7021"
