# Sunplus SP7021 工業板固定來源軟體候選。
BOARD_NAME="Banana Pi F2S"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="sunplus-sp7021-bpi"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2021"

KERNEL_TARGET="legacy"
KERNEL_TEST_TARGET="legacy"
BOOTCONFIG="sp7021_bpi_f2s_defconfig"
BOOT_FDT_FILE="sp7021-bpi-f2s.dtb"
SRC_EXTLINUX="no"
BOOTFS_TYPE="fat"
BOOTSIZE="256"
SERIALCON="ttyS0"
HAS_VIDEO_OUTPUT="yes"
PACKAGE_LIST_BOARD="ethtool iproute2 iperf3 mmc-utils usbutils usb-modeswitch evtest gpiod i2c-tools python3-libgpiod python3-spidev spi-tools v4l-utils fio stress-ng"

SUNPLUS_BPI_BSP_REPO="https://github.com/BPI-SINOVOIP/BPI-F2S-bsp.git"
SUNPLUS_BPI_BSP_BRANCH="commit:3eee97bd8fb7582c2d9942a533647c3d78222bb5"
SUNPLUS_BPI_BSP_BOARD="bpi-f2s"
SUNPLUS_BPI_VENDOR_BOARD="bpi-f2s"
SUNPLUS_BPI_VENDOR_CHIP="SP7021"
SUNPLUS_BPI_SD_XBOOT_ASSET="sp-pack/sp7021/common/bin/ISPBOOOT.BIN"
SUNPLUS_BPI_SD_XBOOT_SHA256="e01081a92b55156868b9df7918e0d5f503d1dda3af94335ed24637786124964a"
SUNPLUS_BPI_EMMC_XBOOT_ASSET="sp-pack/sp7021/common/bin/BPI-F2S-xboot-emmc-boot0-0k.img.gz"
SUNPLUS_BPI_EMMC_XBOOT_SHA256="67e507efb5bef1d67f97f22da3e87dcc32a285a8a8d003ff3149416fc7dbc81d"

function post_family_config__bananapif2s_storage_contract() {
	# 啟動器位於 sector 34；明確使用 MBR，避免與 GPT 項目區重疊。
	declare -g IMAGE_PARTITION_TABLE="msdos"
}

function custom_kernel_config__bananapif2s_diagnostics() {
	# 只開啟供應商核心已有的診斷介面；可用性仍須由實機驗證。
	opts_y+=(THERMAL THERMAL_OF SUNPLUS_SP7021_THERMAL)
	opts_y+=(WATCHDOG WATCHDOG_CORE SUNPLUS_WATCHDOG)
	opts_y+=(USB_CONFIGFS USB_CONFIGFS_MASS_STORAGE)
}
