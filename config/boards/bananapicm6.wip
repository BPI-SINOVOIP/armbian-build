# SpacemiT K1 RISC-V SoC 4GB RAM 16GB eMMC
BOARD_NAME="BananaPi BPI-CM6"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="spacemit"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2026"
KERNEL_TARGET="legacy"
KERNEL_TEST_TARGET="legacy"
BOOT_FDT_FILE="spacemit/k1-x_bpi_cm6.dtb"
BOOTDELAY=1
SRC_EXTLINUX="yes"
SRC_CMDLINE="earlycon=sbi console=tty1 console=ttyS0,115200 loglevel=1"
OVERLAY_PREFIX="k1"
IMAGE_PARTITION_TABLE="msdos"
PACKAGE_LIST_BOARD="rfkill bluetooth bluez bluez-tools gpiod i2c-tools python3-libgpiod python3-spidev v4l-utils pciutils nvme-cli usbutils alsa-utils iw ethtool"

function post_family_config__bananapicm6_use_bpi_k1_sources() {
	declare -g BOOTSOURCE="https://github.com/BPI-SINOVOIP/pi-u-boot.git"
	declare -g BOOTBRANCH="commit:066cccd77f35e57d13363fea524a439759196dca"
	declare -g BOOTPATCHDIR="legacy/u-boot-spacemit-k1-cm6"
	declare -g ATFBRANCH="commit:05479f5228f3fab2a4221fe0745f3703171ace58"
	declare -g KERNELSOURCE="https://github.com/BPI-SINOVOIP/pi-linux.git"
	declare -g KERNELBRANCH="commit:0d0af0d895251383baee939d44e523699e31889f"
	declare -g KERNEL_MAJOR_MINOR="6.6"
	declare -g KERNELPATCHDIR="bananapicm6-legacy"
	declare -g LINUXCONFIG="linux-spacemit-legacy"
}

function post_config_uboot_target__extra_configs_for_bananapi_cm6() {
	display_alert "u-boot for ${BOARD}" "u-boot: enabling extra configs" "info"
	run_host_command_logged scripts/config --enable CONFIG_SD_BOOT
	run_host_command_logged scripts/config --enable CONFIG_EXT4_WRITE
	run_host_command_logged scripts/config --enable CONFIG_FS_BTRFS
	run_host_command_logged scripts/config --enable CONFIG_CMD_BTRFS
	run_host_command_logged scripts/config --enable CONFIG_SPI_FLASH_USE_4K_SECTORS
	declare -g UBOOT_LOGLEVEL="1"
}

function post_uboot_custom_postprocess__bananapicm6_payload_permissions() {
	# U-Boot 產生此檔時會受建置主機 umask 影響，封裝前固定為可散布模式。
	run_host_command_logged chmod 0644 ./u-boot-env-default.bin
}

function post_family_tweaks_bsp__bananapi_cm6_extras() {
	if [[ -d "$SRC/packages/blobs/riscv64/spacemit" ]]; then
		run_host_command_logged mkdir -pv "${destination}"/lib/firmware
		run_host_command_logged mkdir -pv "${destination}"/usr/share/doc/armbian-bsp-bananapicm6
		display_alert "$BOARD" "Installing boot firmware" "info"
		run_host_command_logged cp -fv "$SRC"/packages/blobs/riscv64/spacemit/esos.elf "${destination}"/lib/firmware
		run_host_command_logged cp -fv "$SRC"/packages/blobs/riscv64/spacemit/LICENSE.spacemit_esos \
			"${destination}"/usr/share/doc/armbian-bsp-bananapicm6/esos.elf.LICENSE
		run_host_command_logged cp -fv "$SRC"/packages/blobs/riscv64/spacemit/SOURCE.zh-TW.md \
			"${destination}"/usr/share/doc/armbian-bsp-bananapicm6/esos.elf.SOURCE.zh-TW.md
	fi
	display_alert "$BOARD" "Force load wireless" "info"
	run_host_command_logged mkdir -pv "${destination}"/etc/modules-load.d
	run_host_command_logged echo "8852bs" >"${destination}"/etc/modules-load.d/${BOARD}.conf
}
