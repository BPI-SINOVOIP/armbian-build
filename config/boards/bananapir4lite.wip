# Mediatek MT7987A router board
BOARD_NAME="Banana Pi R4 Lite"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="filogic"
BOARD_MAINTAINER=""
INTRODUCED="2025"
KERNEL_TARGET="current"
KERNEL_TEST_TARGET="current"
BOOTCONFIG="mt7987a_bananapi_bpi-r4-lite-sdmmc_defconfig"
BOOT_FDT_FILE="mediatek/mt7987a-bananapi-bpi-r4-lite-sd.dtb"
SRC_EXTLINUX="yes"
SRC_CMDLINE="console=ttyS0,115200n1 earlyprintk loglevel=8 initcall_debug=0 swiotlb=512 cgroup_enable cgroup_memory=1 init=/sbin/init"
HAS_VIDEO_OUTPUT="no"

declare -g FILOGIC_SOC="mt7987"
declare -g FILOGIC_BOOT_DEVICE="sdmmc"
declare -g FILOGIC_KERNELBRANCH="branch:6.17-r4lite"
declare -g FILOGIC_KERNEL_MAJOR_MINOR="6.17"
declare -g FILOGIC_KERNELPATCHDIR="archive/filogic-6.17"
