# Allwinner R40 industrial control board, derived from Banana Pi M2 Ultra
BOARD_NAME="Banana Pi BPI-6204"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="sun8i"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2025"
BOOTCONFIG="Bananapi_M2_Ultra_defconfig"
BOOT_FDT_FILE="allwinner/sun8i-r40-bpi-6204.dtb"
OVERLAY_PREFIX="sun8i-r40"
PACKAGE_LIST_BOARD="can-utils ethtool iproute2 iperf3 smartmontools hdparm usbutils alsa-utils iw rfkill wireless-regdb gpiod i2c-tools python3-libgpiod python3-spidev v4l-utils lm-sensors"
KERNEL_TARGET="legacy"
KERNEL_TEST_TARGET="legacy"

# Legacy 候選固定 Linux、U-Boot 與韌體來源，保留 R40 上游 576 MHz DRAM 設定。
KERNELSOURCE_BOARD="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
KERNELBRANCH_BOARD="commit:2538fbeff8a94ee2b54eb09d92209e24a1e650d4"
BOOTBRANCH_BOARD="commit:866ca972d6c3cabeaf6dbac431e8e08bb30b3c8e"
ARMBIAN_FIRMWARE_GIT_REF_BOARD="commit:f50a2a21bcdb77a562b3976930c5c6b521a1df08"

function post_family_config_branch_legacy__bananapi6204_pin_sources() {
	declare -g KERNELSOURCE="${KERNELSOURCE_BOARD}"
	declare -g KERNELBRANCH="${KERNELBRANCH_BOARD}"
	declare -g BOOTBRANCH="${BOOTBRANCH_BOARD}"
	declare -g ARMBIAN_FIRMWARE_GIT_REF="${ARMBIAN_FIRMWARE_GIT_REF_BOARD}"
}
