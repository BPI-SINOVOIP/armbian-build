# MediaTek MT7986A、雙 2.5GbE 與板載 eMMC 網路板卡
BOARD_NAME="Banana Pi R3 Mini"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="filogic"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2024"
KERNEL_TARGET="current"
KERNEL_TEST_TARGET="current"
BOOTCONFIG="mt7986a_bpir3mini_emmc_defconfig"
BOOT_FDT_FILE="mediatek/mt7986a-bananapi-bpi-r3-mini.dtb"
SRC_EXTLINUX="yes"
SRC_CMDLINE="console=ttyS0,115200n1 earlyprintk loglevel=8 initcall_debug=0 swiotlb=512 cgroup_enable cgroup_memory=1 init=/sbin/init"
HAS_VIDEO_OUTPUT="no"

# Current 候選固定完整啟動鏈與韌體來源，避免可移動分支改變產物。
KERNELSOURCE_BOARD="https://github.com/frank-w/BPI-Router-Linux.git"
KERNELBRANCH_BOARD="commit:4a4506842b77b597f11e7fc53be1dcdbdc97eea9"
BOOTBRANCH_BOARD="commit:34820924edbc4ec7803eb89d9852f4b870fa760a"
ATFBRANCH_BOARD="commit:c34e37802efaea356991a0811c8fc50f8a810f5b"
ARMBIAN_FIRMWARE_GIT_SOURCE_BOARD="https://github.com/armbian/firmware"
ARMBIAN_FIRMWARE_GIT_REF_BOARD="commit:f50a2a21bcdb77a562b3976930c5c6b521a1df08"
MT76_FIRMWARE_GIT_SOURCE_BOARD="https://github.com/openwrt/mt76.git"
MT76_FIRMWARE_GIT_REF_BOARD="commit:c5a3bd91aa735b669618610d5f0ebfa5786845a6"
LINUX_FIRMWARE_GIT_SOURCE_BOARD="https://gitlab.com/kernel-firmware/linux-firmware.git"
LINUX_FIRMWARE_GIT_REF_BOARD="commit:01205307636157a12c29e6a774bf83b218732050"
PACKAGE_LIST_BOARD="bridge-utils ethtool gdisk gpiod hdparm i2c-tools iperf3 iproute2 iw lm-sensors mmc-utils mtd-utils nftables nvme-cli pciutils python3-libgpiod python3-spidev rfkill smartmontools tcpdump usbutils vlan wireless-regdb"

declare -g FILOGIC_SOC="mt7986"
declare -g FILOGIC_BOOT_DEVICE="emmc"
declare -g FILOGIC_ATF_FLAGS="DRAM_USE_DDR4=1 HAVE_DRAM_OBJ_FILE=yes"

function post_family_config_branch_current__bananapir3mini_pin_sources() {
	declare -g KERNELSOURCE="${KERNELSOURCE_BOARD}"
	declare -g KERNELBRANCH="${KERNELBRANCH_BOARD}"
	declare -g BOOTBRANCH="${BOOTBRANCH_BOARD}"
	declare -g ATFBRANCH="${ATFBRANCH_BOARD}"
	declare -g ARMBIAN_FIRMWARE_GIT_SOURCE="${ARMBIAN_FIRMWARE_GIT_SOURCE_BOARD}"
	declare -g ARMBIAN_FIRMWARE_GIT_REF="${ARMBIAN_FIRMWARE_GIT_REF_BOARD}"
}

function custom_kernel_config__bananapir3mini_network_and_storage() {
	opts_m+=(AIR_EN8811H_PHY)
}

function post_config_uboot_target__bananapir3mini_standard_boot() {
	display_alert "U-Boot ${BOARD}" "啟用 eMMC extlinux 自動開機並保護環境分割區" "info"
	run_host_command_logged scripts/config --enable CONFIG_AUTOBOOT
	run_host_command_logged scripts/config --disable CONFIG_AUTOBOOT_KEYED
	run_host_command_logged scripts/config --disable CONFIG_AUTOBOOT_MENU_SHOW
	run_host_command_logged scripts/config --set-val CONFIG_BOOTDELAY 1
	run_host_command_logged scripts/config --disable CONFIG_USE_DEFAULT_ENV_FILE
	run_host_command_logged scripts/config --enable CONFIG_BOOTSTD
	run_host_command_logged scripts/config --enable CONFIG_BOOTSTD_FULL
	run_host_command_logged scripts/config --enable CONFIG_BOOTSTD_DEFAULTS
	run_host_command_logged scripts/config --enable CONFIG_BOOTSTD_BOOTCOMMAND
	run_host_command_logged scripts/config --enable CONFIG_BOOTMETH_EXTLINUX
	run_host_command_logged scripts/config --enable CONFIG_CMD_BOOTFLOW
	run_host_command_logged scripts/config --enable CONFIG_CMD_BOOTFLOW_FULL
	run_host_command_logged scripts/config --enable CONFIG_FS_EXT4
	run_host_command_logged scripts/config --enable CONFIG_CMD_EXT4
	run_host_command_logged scripts/config --set-str CONFIG_DEFAULT_FDT_FILE \
	  mediatek/mt7986a-bananapi-bpi-r3-mini.dtb
	run_host_command_logged scripts/config --disable CONFIG_ENV_IS_NOWHERE
	run_host_command_logged scripts/config --enable CONFIG_ENV_IS_IN_MMC
	run_host_command_logged scripts/config --enable CONFIG_SYS_REDUNDAND_ENVIRONMENT
	run_host_command_logged scripts/config --enable CONFIG_USE_ENV_MMC_PARTITION
	run_host_command_logged scripts/config --set-str CONFIG_ENV_MMC_PARTITION ubootenv
	run_host_command_logged scripts/config --set-val CONFIG_ENV_SIZE 0x40000
	run_host_command_logged scripts/config --set-val CONFIG_ENV_OFFSET 0x400000
	run_host_command_logged scripts/config --set-val CONFIG_ENV_OFFSET_REDUND 0x440000
	run_host_command_logged scripts/config --set-val CONFIG_SYS_MMC_ENV_DEV 0
}

# 內建 MT7986 Wi-Fi 與兩個 EN8811H PHY 的韌體皆以固定來源收入 BSP。
function post_family_tweaks_bsp__bananapir3mini_network_firmware() {
	local firmware_commit="${MT76_FIRMWARE_GIT_REF_BOARD#commit:}"
	local firmware_source firmware_file
	local airoha_source="${SRC}/packages/blobs/filogic/firmware/airoha"
	fetch_from_repo "${MT76_FIRMWARE_GIT_SOURCE_BOARD}" "mt76-firmware" \
	  "${MT76_FIRMWARE_GIT_REF_BOARD}" "yes"
	firmware_source="${SRC}/cache/sources/mt76-firmware/${firmware_commit}/firmware"
	for firmware_file in \
		mt7986_wa.bin mt7986_wm.bin mt7986_wm_mt7975.bin \
		mt7986_rom_patch.bin mt7986_rom_patch_mt7975.bin \
		mt7986_wo_0.bin mt7986_wo_1.bin \
		mt7986_eeprom_mt7975.bin mt7986_eeprom_mt7975_dual.bin \
		mt7986_eeprom_mt7976.bin mt7986_eeprom_mt7976_dbdc.bin \
		mt7986_eeprom_mt7976_dual.bin; do
		run_host_command_logged install -Dm0644 \
		  "${firmware_source}/${firmware_file}" \
		  "${destination}/lib/firmware/mediatek/${firmware_file}"
	done
	for firmware_file in EthMD32.dm.bin EthMD32.DSP.bin; do
		run_host_command_logged install -Dm0644 \
		  "${airoha_source}/${firmware_file}" \
		  "${destination}/lib/firmware/airoha/${firmware_file}"
	done
	run_host_command_logged install -Dm0644 "${firmware_source}/LICENSE" \
	  "${destination}/usr/share/doc/armbian-bsp-${BOARD}/mt76-firmware.LICENSE"
	run_host_command_logged install -Dm0644 "${airoha_source}/LICENSE.airoha" \
	  "${destination}/usr/share/doc/armbian-bsp-${BOARD}/LICENSE.airoha"
	run_host_command_logged install -Dm0644 "${airoha_source}/SOURCE.md" \
	  "${destination}/usr/share/doc/armbian-bsp-${BOARD}/airoha-firmware-SOURCE.md"
}
