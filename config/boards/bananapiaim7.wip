# Rockchip RK3588 BPI-AIM7, initial ArmSoM AIM7 IO-derived bring-up
source "${SRC}/config/boards/armsom-aim7-io.csc"
BOARD_NAME="Banana Pi AIM7"
BOARD_VENDOR="sinovoip"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2024"
BOOTCONFIG="armsom-aim7-io-rk3588_defconfig"
BOOT_FDT_FILE="rockchip/rk3588-armsom-aim7-io.dtb"
# These are included in armsom-aim7-io.csc, but this file is parsed directly
# by the JSON matrix generator and thus those need to be in here.
KERNEL_TARGET="vendor"
BOARDFAMILY="rockchip-rk3588"
