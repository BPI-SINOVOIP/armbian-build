# Rockchip RK3588 Banana Pi AIM7 固定來源軟體候選。
BOARD_NAME="Banana Pi AIM7"
BOARD_VENDOR="sinovoip"
BOARDFAMILY="rockchip-rk3588"
BOARD_MAINTAINER="BPI-SINOVOIP"
INTRODUCED="2024"
BOOTCONFIG="bananapi-aim7-rk3588_defconfig"
KERNEL_TARGET="vendor"
KERNEL_TEST_TARGET="vendor"
FULL_DESKTOP="yes"
BOOT_LOGO="desktop"
BOOT_FDT_FILE="rockchip/rk3588-bananapi-aim7.dtb"
BOOT_SCENARIO="spl-blobs"
IMAGE_PARTITION_TABLE="gpt"
DDR_BLOB="rk35/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v1.20_20250926.bin"
BL31_BLOB="rk35/rk3588_bl31_v1.48.elf"
BOOTBRANCH_BOARD="commit:39cd993e5d6296635438e84f4576b3a9bf76f86e"
KERNELBRANCH_BOARD="commit:c6157104418d012823413c02f9222f3fe123dd25"
RKBIN_GIT_REF="commit:1d3c61008fa823936ae7a59615393f8294b64456"
PACKAGE_LIST_BOARD="gpiod i2c-tools python3-libgpiod python3-spidev spi-tools pciutils nvme-cli usbutils usb-modeswitch evtest ethtool iproute2 iperf3 libdrm-tests mesa-utils glmark2-es2 vulkan-tools vainfo v4l-utils ffmpeg gstreamer1.0-tools gstreamer1.0-plugins-bad clinfo"

function post_family_config_branch_vendor__bananapiaim7_pin_sources() {
	declare -g BOOTSOURCE="https://github.com/radxa/u-boot.git"
	declare -g BOOTBRANCH="${BOOTBRANCH_BOARD}"
	declare -g KERNELSOURCE="https://github.com/armbian/linux-rockchip.git"
	declare -g KERNELBRANCH="${KERNELBRANCH_BOARD}"
	declare -g RKBIN_GIT_URL="https://github.com/armbian/rkbin"
}

function custom_kernel_config__bananapiaim7_io_contract() {
	opts_y+=(GPIO_CDEV HID HID_GENERIC HIDRAW I2C_CHARDEV INPUT_EVDEV)
	opts_y+=(MALI_BIFROST MALI_CSF_SUPPORT PCIE_DW_ROCKCHIP)
	opts_y+=(ROCKCHIP_MPP_RKVDEC2 ROCKCHIP_MPP_RKVENC2 ROCKCHIP_MPP_SERVICE)
	opts_y+=(ROCKCHIP_MULTI_RGA ROCKCHIP_RKNPU SPI_SPIDEV)
	opts_y+=(USB_CONFIGFS_MASS_STORAGE USB_HID USB_ROLE_SWITCH)
}

function post_family_tweaks__bananapiaim7_naming_audios() {
	display_alert "$BOARD" "設定 AIM7 音訊裝置名稱" "info"

	mkdir -p "${SDCARD}/etc/udev/rules.d/"
	printf '%s\n' \
		'SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-hdmi0-sound", ENV{SOUND_DESCRIPTION}="HDMI0 Audio"' \
		'SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-dp0-sound", ENV{SOUND_DESCRIPTION}="DP0 Audio"' \
		>"${SDCARD}/etc/udev/rules.d/90-naming-audios.rules"
}

function post_family_tweaks_bsp__bananapiaim7_rkbin_license() {
	local license_source="${RKBIN_DIR}/LICENSE.TXT"
	local license_target="${destination}/usr/share/doc/armbian-bsp-${BOARD}/rkbin.LICENSE.TXT"
	[[ -f "${license_source}" ]] || exit_with_error "BPI-AIM7 缺少 RKBin 授權檔：${license_source}"
	run_host_command_logged install -Dm0644 "${license_source}" "${license_target}"
}
