{
  "schema_version": 1,
  "common_packages": [
    "rfkill",
    "bluetooth",
    "bluez",
    "bluez-tools",
    "gpiod",
    "i2c-tools",
    "python3-libgpiod",
    "python3-spidev",
    "v4l-utils"
  ],
  "common_kernel_options": {
    "CONFIG_ARCH_SUNXI": "y",
    "CONFIG_BRCMFMAC": "m",
    "CONFIG_BT_HCIUART": "m",
    "CONFIG_BT_HCIUART_BCM": "y",
    "CONFIG_CRYPTO_DEV_SUN4I_SS": "y",
    "CONFIG_DRM_LIMA": "m",
    "CONFIG_DRM_SUN4I": "y",
    "CONFIG_I2C_MV64XXX": "y",
    "CONFIG_MMC_SUNXI": "y",
    "CONFIG_PWM_SUN4I": "m",
    "CONFIG_RFKILL": "m",
    "CONFIG_SPI_SUN4I": "y",
    "CONFIG_STMMAC_ETH": "y",
    "CONFIG_USB_CONFIGFS_MASS_STORAGE": "y",
    "CONFIG_USB_GADGET": "y",
    "CONFIG_USB_MUSB_SUNXI": "m",
    "CONFIG_VIDEO_SUNXI_CEDRUS": "m"
  },
  "boards": {
    "bananapim2zero": {
      "family": "sun8i",
      "dtb": "allwinner/sun8i-h2-plus-bananapi-m2-zero.dtb",
      "model": "Banana Pi BPI-M2-Zero",
      "compatible": [
        "sinovoip,bpi-m2-zero",
        "allwinner,sun8i-h2-plus"
      ],
      "uboot_tag": "v2026.07",
      "uboot_payload": "u-boot-sunxi-with-spl.bin",
      "uboot_offset": 8192,
      "overlay_prefix": "sun8i-h3",
      "sd_node": "/soc/mmc@1c0f000",
      "sd_bus_width": 4,
      "additional_bus_widths": [
        "/soc/mmc@1c10000=4"
      ],
      "default_overlays": [],
      "required_overlays": [
        "i2c0",
        "i2c1",
        "i2c2",
        "pwm",
        "spi-add-cs1",
        "spi-spidev",
        "uart1",
        "uart2",
        "uart3",
        "w1-gpio"
      ],
      "required_status_nodes": [
        "/display-engine",
        "/soc/hdmi@1ee0000",
        "/soc/mmc@1c0f000",
        "/soc/mmc@1c10000",
        "/soc/usb@1c19000",
        "/soc/usb@1c1a000",
        "/soc/usb@1c1a400"
      ]
    },
    "bananapip2zero": {
      "family": "sun8i",
      "dtb": "allwinner/sun8i-h2-plus-bananapi-p2-zero.dtb",
      "model": "Banana Pi BPI-P2-Zero",
      "compatible": [
        "sinovoip,bpi-p2-zero",
        "sinovoip,bpi-m2-zero",
        "allwinner,sun8i-h2-plus"
      ],
      "uboot_tag": "v2026.07",
      "uboot_payload": "u-boot-sunxi-with-spl.bin",
      "uboot_offset": 8192,
      "overlay_prefix": "sun8i-h3",
      "sd_node": "/soc/mmc@1c0f000",
      "sd_bus_width": 4,
      "additional_bus_widths": [
        "/soc/mmc@1c10000=4",
        "/soc/mmc@1c11000=8"
      ],
      "default_overlays": [],
      "required_overlays": [
        "i2c0",
        "i2c1",
        "i2c2",
        "pwm",
        "spi-add-cs1",
        "spi-spidev",
        "uart1",
        "uart2",
        "uart3",
        "w1-gpio"
      ],
      "required_status_nodes": [
        "/display-engine",
        "/soc/ethernet@1c30000",
        "/soc/hdmi@1ee0000",
        "/soc/mmc@1c0f000",
        "/soc/mmc@1c10000",
        "/soc/mmc@1c11000",
        "/soc/usb@1c19000",
        "/soc/usb@1c1a000",
        "/soc/usb@1c1a400"
      ]
    }
  }
}
