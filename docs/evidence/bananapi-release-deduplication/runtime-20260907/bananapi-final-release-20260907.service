[Unit]
Description=Banana Pi 全矩陣正式發布收尾

[Service]
Type=exec
User=pi
Group=pi
RemainAfterExit=yes
WorkingDirectory=/media/pi/SMCI/armbian/bpi-v26.2.1-bananapi-optimize
Environment=TOOL_REPO=/media/pi/SMCI/armbian/bpi-v26.2.1-bananapi-optimize
Environment=MATRIX_FILE=/media/pi/SMCI/armbian/bpi-v26.2.1-bananapi-optimize/config/bananapi-latest-release-matrix.tsv
Environment=CANDIDATE_RELEASE=/media/pi/SMCI/bpi/bananapi-release-c8673931c96c
